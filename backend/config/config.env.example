PORT=5000
NODE_ENV=DEVELOPMENT

# Auth — JWT secret should be a long random string in real deployments.
JWT_SECRET=
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7

# MongoDB
DB_LOCAL_URI=mongodb://127.0.0.1:27017/dubverse
DB_URI=

# Groq — used for Whisper transcription + LLaMA speaker/character analysis + translation
GROQ_API_KEY=

# ElevenLabs — text-to-speech
ELEVENLABS_API_KEY=
# Comma-separated ElevenLabs voice IDs to round-robin across detected speakers.
# Defaults below are ElevenLabs' own stock voices (safe to leave as-is to start).
ELEVENLABS_MALE_VOICE_IDS=pNInz6obpgDQGcFmaJgB,onwK4e9ZLuTAKqWW03F9
ELEVENLABS_FEMALE_VOICE_IDS=21m00Tcm4TlvDq8ikWAM,EXAVITQu4vr4xnSDxMaL

# Cloudinary — video storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FRONTEND_URL=http://localhost:5173
